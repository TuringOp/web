{
  "name": "turing-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A two-page Turing marketing site deployable on Cloudflare Workers.",
  "scripts": {
    "verify:cloudflare": "node ./scripts/verify-cloudflare-assets.mjs",
    "dev": "wrangler dev",
    "tunnel:validate": "cloudflared tunnel --config ./cloudflared/config.generated.yml ingress validate",
    "tunnel:run": "cloudflared tunnel --config ./cloudflared/config.generated.yml run music-jepa-api",
    "precheck": "npm run verify:cloudflare",
    "check": "wrangler deploy --dry-run",
    "predeploy": "npm run verify:cloudflare",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "3.114.17"
  }
}

